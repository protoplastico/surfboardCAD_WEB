  "principles": [
    "Geometry with explicit units and datum is authoritative; market names are presets or aliases.",
    "Topology, dimensions, modifiers, and performance claims are separate layers.",
    "Use few semantic control points; measurement stations remain virtual constraints when possible.",
    "Use G1 for ordinary joins and target G2 for fair regions; preserve intentional corners and feature lines.",
    "Keep terminal tail and nose control points because they control tip radius, pod width, lobes, and notches.",
    "Do not infer performance from one detail without operating conditions and evidence."
  ],
  "units": { "length": "mm", "angle": "deg", "area": "mm2", "volume": "mm3" },
  "taxonomy": {
    "tail": [
      {"id":"tail.solid_block","topology":"finite terminal block","variants":["square","rounded_square"],"required":["tailWidth12Mm","blockWidthMm","cornerRadiusMm","hipXMm","joinXMm","joinContinuity"]},
      {"id":"tail.solid_rounded","topology":"single rounded terminal curve","variants":["squash","round","thumb"],"required":["tailWidth12Mm","tipWidthMm","tipRadiusMm","hipXMm","joinXMm","joinContinuity"]},
      {"id":"tail.solid_pointed","topology":"monotonic convergence to center terminal","variants":["pin","round_pin","diamond"],"required":["tailWidth12Mm","tipPodWidthMm","tipRadiusMm","shoulderXMm","joinContinuity"]},
      {"id":"tail.center_notched","topology":"two rear tips and center notch","variants":["swallow","deep_swallow","half_moon","split"],"required":["tailWidth12Mm","tipSeparationMm","eachTipWidthMm","notchDepthMm","notchRadiusMm","outerCornerRadiusMm","joinContinuity"]},
      {"id":"tail.multi_lobed","topology":"three or more terminal extrema","variants":["bat","star"],"required":["terminalPoints","cutoutDepthsMm","cornerRadiiMm","joinContinuity"]}
    ],
    "nose": [
