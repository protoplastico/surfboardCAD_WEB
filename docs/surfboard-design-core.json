  "implementationAudit": {
    "p0": [
      "rail semantic/base geometry persistence is incomplete",
      "legacy overlapping bottom features may be silently redistributed",
      "runtime base and generated-section metadata are lost on export",
      "rocker can rebase on already modified geometry after reload"
    ],
    "p1": [
      "square nose selection has no valid generation path",
      "wide nose is incorrectly modeled as a topology enum and mapped toward a pointed form",
      "diamond tail can produce a flat center block instead of one center tip",
      "star tail topology differs from common bat/star definitions",
      "tail and nose joins are forced to G0 where ordinary joins should be fair",
      "soft, tucked, and hard edge are incorrectly exclusive",
      "rail geometry lacks authoritative apex/fullness/tuck/radius paths",
      "bottom operations create excessive editable sections/control points"
    ],
    "classificationData": {
      "tail": "not suitable as ground truth due to duplicates, conflicting labels, and missing provenance",
      "nose": "333 records are unlabeled; not a classification ground truth"
    }
  },
  "recommendedSequence": [
    "stop destructive save/load transformations and add roundtrip tests",
    "introduce schema v2 with datum, units, base geometry, modifier stack, and semantic landmarks",
    "preserve legacy baked geometry without forced preset inference",
    "correct tail/nose taxonomy and ordinary G1/G2 joins while retaining terminal CPs",
    "split edge into outer radius, tuck, and release roles",
    "implement longitudinal rail semantic paths and landmark-aligned lofting",
    "represent bottom as analytic features with smooth envelopes and derived stations",
    "represent rocker as datum-aware base curves plus fair modifiers",
    "add fixed-view thumbnails, definitions, dimensions, ambiguity warnings, and evidence grades"
  ],
