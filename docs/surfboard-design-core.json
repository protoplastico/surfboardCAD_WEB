      {"id":"nose.rounded","topology":"single rounded terminal curve","variants":["round","round_point","full_round"],"required":["noseWidth12Mm","tipWidthMm","tipRadiusMm","shoulderXMm","joinXMm","joinContinuity"]},
      {"id":"nose.block","topology":"finite transverse pod with corners","variants":["square","snub","blunt"],"required":["noseWidth12Mm","podWidthMm","cornerRadiusMm","shoulderXMm","joinContinuity"]}
    ],
    "rail": [
      {"id":"rail.rounded","required":["apexHeightRatioPath","apexInsetMmPath","deckFullnessPath","bottomFullnessPath","outerRadiusMmPath","deckTangency","bottomTangency"]},
      {"id":"rail.chined","required":["apexHeightRatioPath","boundaryPaths","bevelWidthsMm","bevelAnglesDeg","cornerRadiiMm"]}
    ],
    "bottom": ["bottom.planar","bottom.single_concave","bottom.double_concave","bottom.vee","bottom.convex_hull","bottom.displacement_hull","bottom.channel","bottom.chine"],
    "rocker": ["rocker.base_curve","rocker.entry_lift","rocker.tail_kick","rocker.center_flatten"],
